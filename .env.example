# --- WhatsApp Cloud API (required) ---
# Meta → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret word; paste the same value in Meta's webhook config
WEBHOOK_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# --- Security (recommended) ---
# Meta → App settings → Basic → App secret. Enables webhook signature checks.
META_APP_SECRET=

# --- Lead notifications (optional) ---
# Number that receives a WhatsApp alert for each new lead, e.g. 5491112345678
ADMIN_PHONE=

# --- Persistence (optional; in-memory if empty) ---
# Supabase → Project settings → API. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- /admin panel (optional) ---
ADMIN_USER=admin
ADMIN_PASSWORD=
