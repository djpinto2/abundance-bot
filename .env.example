# Token de acceso (en Meta: WhatsApp > API Setup). El temporal dura 24 h.
WHATSAPP_TOKEN=

# Phone number ID (NO es el número de teléfono, es un ID largo que aparece en API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# Palabra secreta que inventás vos y pegás también en la config del webhook en Meta
WEBHOOK_VERIFY_TOKEN=abundance-bot-2026

# Versión de la Graph API (opcional)
GRAPH_API_VERSION=v23.0
